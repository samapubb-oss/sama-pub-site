# Supabase Configuration (site vitrine & dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic Claude API (Dashboard uniquement - Côté serveur STRICT, ne jamais préfixer par NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Higgsfield API — Kling 4.0 Création Vidéo (SERVEUR UNIQUEMENT — NE JAMAIS PRÉFIXER PAR NEXT_PUBLIC_)
# Option 1 (recommandée par la doc HTTP) : identifiant et secret séparés
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Option 2 (format combiné SDK @higgsfield/client/v2) : "KEY_ID:KEY_SECRET"
HF_CREDENTIALS=

# Webhook Higgsfield optionnel (Standard Webhooks — secret commençant par whsec_)
HF_WEBHOOK_SECRET=
HF_WEBHOOK_URL=

# Garde-fous coûts & quotas pour la création vidéo (optionnel, valeurs par défaut ci-dessous)
VIDEO_MAX_DURATION_SECONDS=30
VIDEO_MAX_DAILY_GENERATIONS=20
VIDEO_MAX_MONTHLY_BUDGET_USD=50
